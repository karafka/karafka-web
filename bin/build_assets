#!/usr/bin/env bash

rm -f lib/karafka/web/ui/public/javascripts/application.min.*
rm -f lib/karafka/web/ui/public/stylesheets/application.min.*
rm -f lib/karafka/web/ui/public/stylesheets/libs/highlight_light.min.css.*
rm -f lib/karafka/web/ui/public/stylesheets/libs/highlight_dark.min.css.*

set -e

npx postcss \
  lib/karafka/web/ui/public/stylesheets/libs/tailwind.css \
  -o lib/karafka/web/ui/public/stylesheets/libs/tailwind.min.css

js_dir=lib/karafka/web/ui/public/javascripts
css_dir=lib/karafka/web/ui/public/stylesheets

js_files=$(
  find "$js_dir/libs" -name '*.js' | sort
  find "$js_dir/charts" -name '*.js' | sort
  find "$js_dir/components" -name '*.js' | sort
  echo "$js_dir/application.js"
)

# Files stay separate uglifyjs inputs, so the dev sourcemap points to each original file
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

tmp_files=()
for file in $js_files; do
  mkdir -p "$tmp_dir/$(dirname "$file")"
  { printf '/*! Source: %s */\n\n' "$file"; cat "$file"; } > "$tmp_dir/$file"
  tmp_files+=("$tmp_dir/$file")
done

uglify_options=(--compress --mangle --comments '/@preserve|@license|@cc_on|^!/')

if [ "$KARAFKA_RELEASE" != "true" ]; then
  uglify_options+=(--source-map "base='$tmp_dir',url='application.min.js.map',includeSources")
fi

npx uglifyjs "${tmp_files[@]}" "${uglify_options[@]}" -o "$js_dir/application.min.js"

css_files=(
  "$css_dir/libs/datepicker.min.css"
  "$css_dir/libs/tailwind.min.css"
  "$css_dir/application.css"
)

for i in "${!css_files[@]}"; do
  [ "$i" -gt 0 ] && echo
  cat "${css_files[$i]}"
done > "$css_dir/application.min.css"

# We remove the intermediate tailwind file because its already bundled
rm "$css_dir/libs/tailwind.min.css"

compress_file() {
  local input_file="$1"
  local output_dir
  output_dir=$(dirname "$input_file")
  local base_name
  base_name=$(basename "$input_file")

  # Check if input file exists
  if [ ! -f "$input_file" ]; then
    echo "Input file not found: $input_file"
    return 1
  fi

  # Compress with Brotli
  brotli -k -q 11 "$input_file" -o "$output_dir/$base_name.br"
  if [ $? -ne 0 ]; then
    echo "Brotli compression failed"
    return 1
  fi

  # Compress with Gzip
  gzip -k -9 "$input_file" -c > "$output_dir/$base_name.gz"
  if [ $? -ne 0 ]; then
    echo "Gzip compression failed"
    return 1
  fi
}

compress_file "lib/karafka/web/ui/public/stylesheets/application.min.css"
compress_file "lib/karafka/web/ui/public/javascripts/application.min.js"

compress_file "lib/karafka/web/ui/public/stylesheets/libs/highlight_light.min.css"
compress_file "lib/karafka/web/ui/public/stylesheets/libs/highlight_dark.min.css"
