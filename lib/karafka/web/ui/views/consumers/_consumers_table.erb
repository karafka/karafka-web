<div class="data-table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th><%== sort_link('Process ID', :id) %></th>
        <th><%== sort_link(:started_at, rev: true) %></th>
        <th>Memory</th>
        <th>Utilization</th>
        <th><%== sort_link(:lag_hybrid) %></th>
      </tr>
    </thead>
    <tbody>
      <%==
        render_each(
          @processes,
          'consumers/_consumer',
          local: :process
        )
      %>
    </tbody>
  </table>
</div>
