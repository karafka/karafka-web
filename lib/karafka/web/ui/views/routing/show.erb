<%
  title = [@topic.group.name, @topic.subscription_group, @topic.name].join(': ')
  view_title title
%>

<div class="data-table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th><%== sort_link('Attribute', :name) %></th>
        <th><%== sort_link(:value) %></th>
      </tr>
    </thead>
    <tbody>
      <% @details.each do |detail| %>
        <%==
          partial(
            'routing/detail',
            locals: {
              k: detail[:name],
              v: detail[:value]
            }
          )
        %>
      <% end %>
    </tbody>
  </table>
</div>
