<% error = @error_message && displayable_error(@error_message) %>
<% if error %>
  <% view_title "#{error[:type]}: #{error[:error_class]}" %>

  <%== partial 'errors/metadata', locals: { error: error } %>
  <%== partial 'errors/backtrace', locals: { error: error } %>
<% else %>
  <% view_title "Offset #{@offset}" %>

  <%== partial 'errors/missing_message', locals: { message: @error_message } %>
<% end %>
