<div class="col-span-12 mb-6">
  <h2 class="h2">
    Backtrace
  </h2>

  <pre class="mb-5 p-0 border border-base-300 text-sm"><code class="wrapped hljs nohighlight p-0 m-0"><% error[:backtrace].to_s.each_line(chomp: true) do |frame| %><span class="<%= backtrace_frame_class(frame) %>"><%= frame %></span><%= "\n" %><% end %></code></pre>
</div>
