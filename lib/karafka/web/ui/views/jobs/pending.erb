<% view_title 'Pending Jobs' %>

<%== partial 'jobs/tabs' %>

<div class="col-span-12">
  <% if !@jobs.empty? || filtering? %>
    <%== filter_box %>
  <% end %>

  <% if @jobs.empty? && !filtering? && params.current_page <= 1 %>
    <%== partial 'jobs/no_jobs', locals: { type: 'pending' } %>
  <% elsif @jobs.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @jobs.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <%== partial 'jobs/jobs_table', locals: { updated_at_label: 'Created' } %>
  <% end %>
</div>
