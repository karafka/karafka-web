<% view_title 'Cluster' %>

<%== partial 'cluster/tabs' %>

<% if Karafka.pro? && (filtering? || !@brokers.empty?) %>
  <div class="col-span-12 mb-3">
    <%== filter_box %>
  </div>
<% end %>

<% if @brokers.empty? && filtering? %>
  <div class="col-span-12">
    <%== partial 'shared/no_filter_results' %>
  </div>
<% else %>
  <div class="col-span-12 mb-3">
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><%== sort_link('Node ID', :id) %></th>
            <th><%== sort_link(:name) %></th>
            <th><%== sort_link(:port) %></th>
          </tr>
        </thead>
        <tbody>
          <%==
            each_partial(
              @brokers,
              'cluster/broker'
            )
          %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
