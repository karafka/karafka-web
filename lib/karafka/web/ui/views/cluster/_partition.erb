<% topic = partition[:topic] %>

<tr>
  <td>
    <%= topic[:topic_name] %>
  </td>
  <td>
    <%= partition[:partition_id] %>
  </td>
  <td>
    <%= partition[:leader] %>
  </td>
  <td>
    <%== partition_replica_brokers(partition) %>
    <div><small class="text-muted"><%= partition[:replica_count] %> replicas</small></div>
  </td>
  <td>
    <%== partition_in_sync_brokers(partition) %>
    <div><small class="text-muted"><%= partition[:in_sync_replica_brokers] %> in-sync</small></div>
  </td>
</tr>
