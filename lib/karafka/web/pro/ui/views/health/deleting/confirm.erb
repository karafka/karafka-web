<% view_title "Deletion of #{@consumer_group_id} offsets for #{@topic_name}" %>

<div class="space-y-4">
  <% alert_box_warning('Offsets Deletion Warning') do %>
    <ul class="list-disc ml-6">
      <li>The committed offsets of this consumer group for all partitions of this topic will be permanently deleted</li>
      <li>The consumer group and its offsets for other topics are kept</li>
      <li>If the consumer group consumes this topic again, it starts from its initial offset</li>
      <li>Kafka rejects the deletion while a running consumer of this consumer group is subscribed to this topic</li>
      <li>This operation cannot be undone</li>
    </ul>
  <% end %>

  <% if @subscribed %>
    <% alert_box_error('Consumer Group Subscribed To Topic') do %>
      Kafka did not delete the offsets because consumer group
      <span class="font-bold"><%= @consumer_group_id %></span>
      has running consumers subscribed to topic
      <span class="font-bold"><%= @topic_name %></span>.
      Stop them or remove this topic from their routing, then try again.
    <% end %>
  <% end %>

  <% if @form_error %>
    <%== partial 'shared/rdkafka_form_error_alert_box' %>
  <% end %>

  <div class="card bg-base-100">
    <div class="card-body">
      <div class="data-table-wrapper">
        <%==
          partial(
            'health/cluster_lags_table',
            locals: {
              topic_name: @topic_name,
              partitions: @cluster_partitions
            }
          )
        %>
      </div>

      <form
        action="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'delete') %>"
        method="post"
        class="mt-6"
        data-turbo="false"
      >
        <input type="hidden" name="_method" value="delete">

        <div class="flex justify-end gap-4">
          <a href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'cluster_lags') %>" class="btn btn-ghost">
            Cancel
          </a>

          <button type="submit" class="btn btn-error gap-2 btn-lockable confirm-action">
            <%== icon(:trash) %>
            Delete Offsets
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
