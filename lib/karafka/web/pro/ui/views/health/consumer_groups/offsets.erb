<% view_title "Consumer group #{@consumer_group.id}" %>

<%== partial 'health/consumer_groups/tabs' %>

<% if filtering? || !@offsets.empty? || params.current_page > 1 %>
  <div class="col-span-12 mb-3">
    <%== filter_box(labels: { topic_name: 'Topic' }) %>
  </div>
<% end %>

<div class="col-span-12">
  <% if @offsets.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @offsets.empty? && params.current_page <= 1 %>
    <% empty_state('This consumer group has no committed offsets.') %>
  <% elsif @offsets.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><%== sort_link('Topic', :topic_name) %></th>
            <th><%== sort_link('Partition', :id) %></th>
            <th><%== sort_link(:lag) %></th>
            <th><%== sort_link(:stored_offset) %></th>
          </tr>
        </thead>
        <tbody>
          <% @offsets.each do |partition| %>
            <tr class="<%= lag_status_row(partition[:lag]) %>">
              <td>
                <a href="<%= explorer_topics_path(partition[:topic_name]) %>">
                  <%= partition[:topic_name] %>
                </a>
              </td>
              <td>
                <a href="<%= explorer_topics_path(partition[:topic_name], partition[:id]) %>">
                  <%= partition[:id] %>
                </a>
              </td>
              <td><%== partition[:lag] %></td>
              <td><%== partition[:stored_offset] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
