<% view_title "Consumer group #{@consumer_group.id}" %>

<%== partial 'health/consumer_groups/tabs' %>

<% if filtering? || !@topics.empty? || params.current_page > 1 %>
  <div class="col-span-12 mb-3">
    <%== filter_box(labels: { name: 'Topic' }) %>
  </div>
<% end %>

<div class="col-span-12">
  <% if @topics.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @topics.empty? && params.current_page <= 1 %>
    <% empty_state('This consumer group has no committed offsets.') %>
  <% elsif @topics.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><%== sort_link('Topic', :name) %></th>
            <th><%== sort_link('Partitions', :partitions_count) %></th>
            <th><%== sort_link('Total lag', :lag) %></th>
            <th><%== sort_link('Max lag', :max_lag) %></th>
            <th><%== sort_link('Avg lag', :avg_lag) %></th>
            <th class="options">Options</th>
          </tr>
        </thead>
        <tbody>
          <% @topics.each do |topic| %>
            <tr class="<%= topic_lag_status_row(topic) %>">
              <td>
                <a href="<%= health_consumer_group_topic_offsets_path(@consumer_group.id, topic.name) %>">
                  <%= topic.name %>
                </a>
              </td>
              <td><%= topic.partitions_count %></td>
              <td><%== lag_with_label topic.lag %></td>
              <td>
                <% if topic.max_lag.positive? %>
                  <a
                    href="<%= "#{health_consumer_group_topic_offsets_path(@consumer_group.id, topic.name)}&sort=lag+desc" %>"
                    title="Highest lag is on partition <%= topic.max_lag_partition_id %>"
                  >
                    <%== lag_with_label topic.max_lag %>
                    [<%= topic.max_lag_partition_id %>]
                  </a>
                <% else %>
                  <%== lag_with_label topic.max_lag %>
                <% end %>
              </td>
              <td><%== lag_with_label topic.avg_lag %></td>
              <td class="options">
                <%==
                  partial(
                    'health/offsets/delete_button',
                    locals: { consumer_group_id: @consumer_group.id, topic_name: topic.name }
                  )
                %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
