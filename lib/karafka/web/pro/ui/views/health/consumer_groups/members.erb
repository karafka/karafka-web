<% view_title "Consumer group #{@consumer_group.id}" %>

<%== partial 'health/consumer_groups/tabs' %>

<% if filtering? || !@members.empty? || params.current_page > 1 %>
  <div class="col-span-12 mb-3">
    <%==
      filter_box(
        labels: {
          member_id: 'Member ID',
          client_id: 'Client ID',
          group_instance_id: 'Group instance ID'
        }
      )
    %>
  </div>
<% end %>

<div class="col-span-12">
  <% if @members.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @members.empty? && params.current_page <= 1 %>
    <% empty_state('This consumer group has no members.') %>
  <% elsif @members.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><%== sort_link('Member ID', :member_id) %></th>
            <th><%== sort_link('Client ID', :client_id) %></th>
            <th><%== sort_link(:host) %></th>
            <th><%== sort_link('Group instance ID', :group_instance_id) %></th>
            <th>Process</th>
            <th>Assignment</th>
          </tr>
        </thead>
        <tbody>
          <% @members.each do |member| %>
            <tr>
              <td><%= member[:member_id] %></td>
              <td><%= member[:client_id] %></td>
              <td><%= member[:host] %></td>
              <td><%= member[:group_instance_id] %></td>
              <td>
                <% membership = @processes_by_member_id[member[:member_id]] %>
                <% if membership %>
                  <% process_id = membership[:process].id %>
                  <a href="<%= consumer_path(process_id, 'subscriptions') %>#<%= membership[:subscription_group].id %>">
                    <%== truncate(process_id, strategy: :middle) %>
                  </a>
                <% else %>
                  <span
                    class="tooltip"
                    data-tip="Not a Karafka process reporting to the Web UI (e.g. another application)"
                  >
                    N/A
                  </span>
                <% end %>
              </td>
              <td>
                <% (member[:assignment] || {}).each do |topic_name, partitions| %>
                  <div title="<%= topics_assignment_label(topic_name, partitions, limit: 25) %>">
                    <%= topics_assignment_text(topic_name, partitions) %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
