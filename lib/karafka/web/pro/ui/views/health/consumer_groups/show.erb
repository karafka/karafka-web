<% view_title "Consumer group #{@consumer_group.id}" %>

<%== partial 'health/tabs' %>

<div class="col-span-12 mb-6">
  <div class="data-table-wrapper">
    <table class="data-table">
      <tbody>
        <tr>
          <td>State</td>
          <td>
            <span class="badge <%= consumer_group_state_badge(@consumer_group[:state]) %>">
              <%= @consumer_group[:state] %>
            </span>
          </td>
        </tr>
        <tr>
          <td>Partition assignor</td>
          <td><%= @consumer_group[:partition_assignor] %></td>
        </tr>
        <tr>
          <td>Coordinator</td>
          <td>
            <% coordinator = @consumer_group[:coordinator] %>
            <% if coordinator %>
              <%= coordinator[:id] %> (<%= coordinator[:host] %>:<%= coordinator[:port] %>)
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="col-span-12 mb-6">
  <h2 class="h2">Members</h2>

  <% if @consumer_group.members.empty? %>
    <p class="text-sm">This consumer group has no members.</p>
  <% else %>
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Member ID</th>
            <th>Client ID</th>
            <th>Host</th>
            <th>Group instance ID</th>
            <th>Assignment</th>
          </tr>
        </thead>
        <tbody>
          <% @consumer_group.members.each do |member| %>
            <tr>
              <td><%= member[:member_id] %></td>
              <td><%= member[:client_id] %></td>
              <td><%= member[:host] %></td>
              <td><%= member[:group_instance_id] %></td>
              <td>
                <% (member[:assignment] || {}).each do |topic_name, partitions| %>
                  <div><%= topic_name %>: <%= partitions.join(', ') %></div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="col-span-12">
  <h2 class="h2">Committed offsets</h2>

  <% if @topics.empty? %>
    <p class="text-sm">This consumer group has no committed offsets.</p>
  <% end %>

  <% @topics.each do |topic_name, partitions| %>
    <div class="data-table-wrapper mb-6">
      <%==
        partial(
          'health/cluster_lags_table',
          locals: {
            topic_name: topic_name,
            partitions: partitions
          }
        )
      %>
    </div>
  <% end %>
</div>
