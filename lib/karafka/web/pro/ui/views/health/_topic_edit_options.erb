<%
  partitions = topic_details[:partitions]

  # Only show buttons if we have partition data
  if partitions.any?
    # Resume All is only usable when at least one partition is paused
    has_paused = partitions.values.any? { |p| p.poll_state != 'active' }

    pause_path = consumers_path(
      'topics',
      encode_path_segment(consumer_group_name),
      topic_name,
      'pause',
      'new'
    )

    resume_path = consumers_path(
      'topics',
      encode_path_segment(consumer_group_name),
      topic_name,
      'pause',
      'edit'
    )
%>

<div class="inline-flex gap-2">
  <%==
    action_link_button(
      "#{icon(:play)} Resume All",
      resume_path,
      classes: 'btn-success btn-sm',
      title: "Resume all paused partitions of this topic within the '#{consumer_group_name}' consumer group",
      disabled_reason: commanding_disabled_reason ||
        (has_paused ? nil : 'No partitions of this topic are paused')
    )
  %>

  <%==
    action_link_button(
      "#{icon(:pause)} Pause All",
      pause_path,
      classes: 'btn-warning btn-sm',
      title: "Pause all partitions of this topic within the '#{consumer_group_name}' consumer group",
      disabled_reason: commanding_disabled_reason
    )
  %>
</div>

<% end %>
