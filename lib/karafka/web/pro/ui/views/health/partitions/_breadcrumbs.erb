<%# Topics are always shown within a consumer group, so surface the group on the drill-down and %>
<%# link it back to the topics list scoped to that group. %>
<li>
  <a href="<%= root_path('health', 'topics') %>?filter[field]=consumer_group&filter[value]=<%= @consumer_group_id %>">
    <%= @consumer_group_id %>
  </a>
</li>

<li>
  <a href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'overview') %>">
    <%= @topic_name %>
  </a>
</li>
