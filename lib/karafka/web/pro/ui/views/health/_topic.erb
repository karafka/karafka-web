<tr class="<%= lso_risk_state_bg(topic_stats) %>">
  <td>
    <a href="<%= root_path('health', 'topics', cg_name, topic_name, 'overview') %>">
      <%= topic_name %>
    </a>
  </td>
  <td>
    <%= topic_stats.present_count %>
    <% if topic_stats.no_data_count.positive? %>
      <span
        class="badge badge-warning"
        title="<%= topic_stats.no_data_count %> assigned partition(s) have no data"
      >
        <%= topic_stats.no_data_count %> no data
      </span>
    <% end %>
  </td>
  <td>
    <%== lag_with_label topic_stats.lag_hybrid %>
  </td>
  <td>
    <span class="badge <%= lag_trend_badge(topic_stats.lag_hybrid_d) %>">
      <%= topic_stats.lag_hybrid_d %>
    </span>
  </td>
  <td>
    <% if topic_stats.max_lag_partition_id >= 0 %>
      <span title="Highest lag is on partition <%= topic_stats.max_lag_partition_id %>">
        <%== lag_with_label topic_stats.max_lag %>
      </span>
    <% else %>
      <%== lag_with_label topic_stats.max_lag %>
    <% end %>
    <% if topic_stats.skewed? %>
      <span
        class="badge badge-warning badge-sm ml-1"
        title="Lag is concentrated on one or few partitions (max is far above the average), not spread evenly"
      >
        skewed
      </span>
    <% end %>
  </td>
  <td>
    <%== lag_with_label topic_stats.avg_lag %>
  </td>
  <td>
    <span class="badge badge-success <%= lso_risk_state_badge(topic_stats) %>">
      <%= topic_stats.lso_risk_state %>
    </span>
  </td>
  <td>
    <% if topic_stats.paused_count.positive? %>
      <span class="badge badge-warning">
        <%= topic_stats.paused_count %> paused
      </span>
    <% else %>
      <span class="badge badge-success">
        all active
      </span>
    <% end %>
  </td>
</tr>
