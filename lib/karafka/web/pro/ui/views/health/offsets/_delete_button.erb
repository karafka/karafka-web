<%
  # Rendered even when the policy denies the deletion, so it is clear the action exists. The
  # title sits on the wrapper because a disabled button does not receive pointer events.
  allowed = ::Karafka::Web.config.ui.policies.consumer_groups.delete_offsets?(
    consumer_group_id,
    topic_name
  )

  if allowed
    disabled_class = ''
    title = 'Delete the committed offsets of this consumer group for this topic'
  else
    disabled_class = 'btn-disabled'
    title = 'Deleting these offsets is not allowed by the Web UI policies'
  end
%>
<span class="inline-flex" title="<%= title %>">
  <a
    href="<%= root_path('health', 'topics', consumer_group_id, topic_name, 'delete') %>"
    class="btn btn-error btn-sm <%= disabled_class %>"
  >
    <%== icon(:trash) %>
    <% if labeled %>
      Delete Offsets
    <% end %>
  </a>
</span>
