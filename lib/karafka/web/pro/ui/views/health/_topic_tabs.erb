<div class="tab-container-wrapper">
  <div class="tab-container">
    <a
      href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'overview') %>"
      class="custom-tab <%= nav_class(match: %r{/overview\z}) %>"
    >
      Overview
    </a>

    <a
      href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'lags') %>"
      class="custom-tab <%= nav_class(match: %r{/lags\z}) %>"
    >
      Lags
    </a>

    <a
      href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'offsets') %>"
      class="custom-tab <%= nav_class(match: %r{/offsets\z}) %>"
    >
      Offsets
    </a>

    <a
      href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'changes') %>"
      class="custom-tab <%= nav_class(match: %r{/changes\z}) %>"
    >
      Changes
    </a>

    <a
      href="<%= root_path('health', 'topics', @consumer_group_id, @topic_name, 'cluster_lags') %>"
      class="custom-tab <%= nav_class(match: %r{/cluster_lags\z}) %>"
    >
      Cluster Lags
    </a>
  </div>
</div>
