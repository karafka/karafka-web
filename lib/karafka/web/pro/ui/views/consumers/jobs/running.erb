<% view_title @process.id %>

<div class="col-span-12">
  <% if @process.status == 'stopped' %>
    <%== partial 'consumers/consumers/consumer/stopped' %>
  <% end %>

  <%== partial 'consumers/consumers/consumer/tabs' %>

  <% if filtering? || !@running_jobs.empty? %>
    <%== filter_box %>
  <% end %>

  <% if @running_jobs.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @running_jobs.empty? %>
    <%== partial 'consumers/jobs/no_jobs', locals: { type: 'running' } %>
  <% else %>
    <%== partial 'consumers/jobs/jobs', locals: { jobs: @running_jobs } %>
  <% end %>
</div>
