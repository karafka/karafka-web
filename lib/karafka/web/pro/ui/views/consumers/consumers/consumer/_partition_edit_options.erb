<%==
  action_link_button(
    icon(:pencil_square),
    consumers_path('partitions', consumer_group_id, topic_name, partition.id, 'offset', 'edit'),
    classes: 'btn-info btn-sm',
    title: 'Edit the offset position for this topic partition',
    disabled_reason: commanding_disabled_reason
  )
%>

<% if partition.poll_state != 'active' %>
  <%==
    action_link_button(
      icon(:play),
      consumers_path('partitions', consumer_group_id, topic_name, partition.id, 'pause', 'edit'),
      classes: 'btn-success btn-sm',
      title: 'Resume processing of this topic partition',
      disabled_reason: commanding_disabled_reason
    )
  %>
<% end %>

<%==
  action_link_button(
    icon(:pause),
    consumers_path('partitions', consumer_group_id, topic_name, partition.id, 'pause', 'new'),
    classes: 'btn-warning btn-sm',
    title: 'Setup or configure pause duration for this topic partition',
    disabled_reason: commanding_disabled_reason
  )
%>
