<% view_title 'Consumers' %>

<%== partial 'consumers/summary' %>
<%== partial 'consumers/consumers/tabs' %>

<div class="col-span-12">
  <% if !@processes.empty? || filtering? %>
    <%== filter_box %>
  <% end %>

  <% if @processes.empty? && !filtering? && params.current_page <= 1 %>
    <%== partial 'consumers/no_consumers' %>
  <% elsif @processes.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @processes.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <%== partial 'consumers/consumers/consumers_table' %>
  <% end %>
</div>
