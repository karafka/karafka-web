<% view_title @process.id %>

<div class="col-span-12">
  <% if @process.status == 'stopped' %>
    <%== partial 'consumers/consumers/consumer/stopped' %>
  <% end %>

  <%== partial 'consumers/consumers/consumer/tabs' %>

  <% if @process.subscribed? %>
    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Consumer Group</th>
            <th>Subscription Group</th>
            <th>Member ID</th>
            <th>Static Membership ID</th>
            <th>State</th>
            <th>Join state</th>
          </tr>
        </thead>
        <tbody>
          <% @process.consumer_groups.each do |consumer_group| %>
            <% consumer_group.subscription_groups.each do |subscription_group| %>
              <%# Reports of processes running versions that do not track it have no member id %>
              <% member_id = subscription_group[:member_id].to_s %>

              <tr>
                <td><%= consumer_group.id %></td>
                <td>
                  <a href="<%= consumer_path(@process.id, 'subscriptions') %>#<%= subscription_group.id %>">
                    <%= subscription_group.id %>
                  </a>
                </td>
                <td>
                  <% if member_id.empty? %>
                    <span
                      class="tooltip"
                      data-tip="Not known yet: the consumer did not join the group or runs an older Karafka Web version"
                    >
                      N/A
                    </span>
                  <% else %>
                    <a href="<%= health_consumer_group_member_path(consumer_group.id, member_id) %>">
                      <%= member_id %>
                    </a>
                  <% end %>
                </td>
                <td><%= subscription_group.instance_id || '' %></td>
                <td>
                  <span class="badge badge-sm <%= kafka_state_badge(subscription_group[:state][:state]) %>">
                    <%= subscription_group[:state][:state] %>
                  </span>
                </td>
                <td>
                  <span class="badge badge-sm <%= kafka_state_badge(subscription_group.join_state) %>">
                    <%= subscription_group.join_state %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%== partial 'consumers/consumers/consumer/no_subscriptions' %>
  <% end %>
</div>
