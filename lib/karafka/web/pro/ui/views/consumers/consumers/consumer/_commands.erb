<div class="col-span-12 flex justify-end space-x-2 mb-6">
  <%==
    action_form_button(
      "#{icon(:gear)} Trace",
      consumers_path('commanding', process.id, 'trace'),
      classes: 'btn-info btn-sm btn-lockable',
      title: 'Trace',
      disabled_reason: process_command_disabled_reason(process, :trace)
    )
  %>

  <%==
    action_form_button(
      "#{icon(:pause)} Quiet",
      consumers_path('commanding', process.id, 'quiet'),
      classes: 'btn-warning btn-sm btn-lockable',
      title: 'Quiet',
      disabled_reason: process_command_disabled_reason(process, :quiet)
    )
  %>

  <%==
    action_form_button(
      "#{icon(:stop)} Stop",
      consumers_path('commanding', process.id, 'stop'),
      classes: 'btn-error btn-sm btn-lockable',
      title: 'Stop',
      disabled_reason: process_command_disabled_reason(process, :stop)
    )
  %>
</div>
