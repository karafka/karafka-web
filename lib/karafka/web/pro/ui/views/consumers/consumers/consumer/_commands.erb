<%
  # Disabled buttons do not receive pointer events, so the reason sits in the form title.
  # When several reasons apply, the first one wins: commanding being off, then a command the
  # process does not support (only standalone processes can be quieted or stopped), then the
  # current state of the process.
  commanding_reason = features.commanding? ? nil : 'Commanding is disabled in the Web UI configuration'
%>

<div class="col-span-12 flex justify-end space-x-2 mb-6">
  <%
    trace_path = consumers_path('commanding', process.id, 'trace')

    title = commanding_reason
    title ||= 'This process is stopped' if process.status == 'stopped'
    disabled_class = title ? 'btn-disabled' : ''
    title ||= 'Trace'
  %>
  <form
    action="<%= trace_path %>"
    method="post"
    class="inline-flex items-center"
    title="<%= title %>"
  >
    <button
      type="submit"
      class="btn btn-info btn-sm btn-lockable <%= disabled_class %>"
    >
      <%== icon(:gear) %>
      Trace
    </button>
  </form>

  <%
    quiet_path = consumers_path('commanding', process.id, 'quiet')

    title = commanding_reason
    if process.execution_mode != 'standalone' || process.tags.include?('embedded')
      title ||= 'Supported only in standalone consumer processes'
    end
    title ||= 'Only a running process can be quieted' unless process.status == 'running'
    disabled_class = title ? 'btn-disabled' : ''
    title ||= 'Quiet'
  %>
  <form
    action="<%= quiet_path %>"
    method="post"
    class="inline-flex items-center"
    title="<%= title %>"
  >
    <button
      type="submit"
      class="btn btn-warning btn-sm btn-lockable <%= disabled_class %>"
    >
      <%== icon(:pause) %>
      Quiet
    </button>
  </form>

  <%
    stop_path = consumers_path('commanding', process.id, 'stop')

    title = commanding_reason
    if process.execution_mode != 'standalone' || process.tags.include?('embedded')
      title ||= 'Supported only in standalone consumer processes'
    end
    if process.status == 'stopping' || process.status == 'stopped'
      title ||= 'This process is already stopping or stopped'
    end
    disabled_class = title ? 'btn-disabled' : ''
    title ||= 'Stop'
  %>
  <form
    action="<%= stop_path %>"
    method="post"
    class="inline-flex items-center"
    title="<%= title %>"
  >
    <button
      type="submit"
      class="btn btn-error btn-sm btn-lockable <%= disabled_class %>"
    >
      <%== icon(:stop) %>
      Stop
    </button>
  </form>
</div>
