<% view_title 'Consumers Controls' %>

<%== partial 'consumers/consumers/tabs' %>

<% unless @processes.empty? %>
  <div class="col-span-12 flex justify-end items-center space-x-2 mb-6">
    <% if filtering? %>
      <span class="text-muted text-sm">
        These actions apply to all processes, not just the filtered ones
      </span>
    <% end %>
    <%
      no_standalone_reason = 'Supported only with standalone consumer processes'
      no_standalone_reason = nil if @processes.any? { |p| p.execution_mode == 'standalone' }
    %>
    <%==
      action_form_button(
        "#{icon(:pause)} Quiet All",
        consumers_path('commanding', 'quiet_all'),
        classes: 'btn-warning btn-sm',
        title: 'Quiet All',
        disabled_reason: no_standalone_reason
      )
    %>

    <%==
      action_form_button(
        "#{icon(:stop)} Stop All",
        consumers_path('commanding', 'stop_all'),
        classes: 'btn-error btn-sm',
        title: 'Stop All',
        disabled_reason: no_standalone_reason
      )
    %>
  </div>
<% end %>

<div class="col-span-12">
  <% if !@processes.empty? || filtering? %>
    <%== filter_box %>
  <% end %>

  <% if @processes.empty? && !filtering? && params.current_page <= 1 %>
    <%== partial 'consumers/no_consumers' %>
  <% elsif @processes.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% elsif @processes.empty? %>
    <%== partial 'shared/no_paginated_data' %>
  <% else %>
    <%== partial 'consumers/controls/processes_table' %>
  <% end %>
</div>
