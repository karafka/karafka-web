<% view_title 'Consumers Commands and Responses' %>

<%== partial 'consumers/consumers/tabs' %>

<div class="col-span-12">
  <%
    no_commands_reason = nil

    if @watermark_offsets.empty? || @watermark_offsets.cleaned?
      no_commands_reason = 'There are no commands to display'
    end
  %>
  <section class="actions">
    <%==
      action_icon_link(
        icon(:play_circle),
        consumers_path('commands', 'recent'),
        title: 'Display the most recent command',
        disabled_reason: no_commands_reason
      )
    %>
  </section>

  <% if @command_messages.empty? && params.current_page == 1 %>
    <%== partial 'consumers/commands/empty' %>
  <% else %>
    <%== partial 'consumers/commands/table' %>
  <% end %>
</div>
