<% view_title "Deletion of messages below offset #{@offset} from partition #{@partition_id}" %>

<div class="space-y-4">
  <% alert_box_warning('Messages Deletion Warning') do %>
    <ul class="list-disc ml-6">
      <li>All messages of this partition below the selected offset will be permanently deleted</li>
      <li>The message at the selected offset and all the newer ones are kept</li>
      <li>Consumers that did not process the deleted messages yet will never receive them</li>
      <li>This operation cannot be undone</li>
    </ul>
  <% end %>

  <% if @form_error %>
    <%== partial 'shared/rdkafka_form_error_alert_box' %>
  <% end %>

  <div class="card bg-base-100">
    <div class="card-body">
      <% if @count.positive? %>
        <div class="alert alert-error">
          <div class="flex items-center gap-4">
            <%== icon(:trash) %>
            <span>
              You are about to delete all messages in offsets
              <span class="font-bold ml-1"><%= @low %></span>
              to
              <span class="font-bold ml-1"><%= @offset - 1 %></span>
              (up to
              <span class="font-bold ml-1"><%= @count %></span>
              messages) from topic
              <span class="font-bold ml-1"><%= @topic_id %></span>
              partition
              <span class="font-bold ml-1"><%= @partition_id %></span>
            </span>
          </div>
        </div>
      <% else %>
        <div class="alert alert-info">
          <span>
            There are no messages below offset
            <span class="font-bold ml-1"><%= @offset %></span>
            in this partition. Its lowest available offset is
            <span class="font-bold ml-1"><%= @low %></span>
          </span>
        </div>
      <% end %>

      <form
        action="<%= explorer_messages_path(@topic_id, @partition_id, @offset, 'delete') %>"
        method="post"
        class="mt-6"
        data-turbo="false"
      >
        <input type="hidden" name="_method" value="delete">

        <div class="flex justify-end gap-4">
          <a href="<%= explorer_topics_path(@topic_id, @partition_id, @offset) %>" class="btn btn-ghost">
            Cancel
          </a>

          <% if @count.positive? %>
            <button type="submit" class="btn btn-error gap-2 btn-lockable confirm-action">
              <%== icon(:trash) %>
              Delete Messages
            </button>
          <% end %>
        </div>
      </form>
    </div>
  </div>
</div>
