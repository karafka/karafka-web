<% view_title "Publishing a message to #{@topic_id}" %>

<% alert_box_info('Message Publishing Operation') do %>
  <p>
    You are about to publish a new message to this topic. This operation:
  </p>

  <ul class="list-disc ml-6 mt-2">
    <li>Creates a new message on the selected topic</li>
    <li>Sends the payload exactly as provided, as raw bytes (no serialization is applied)</li>
    <li>For binary formats (for example Avro), upload the payload as a file</li>
    <li>Cannot be undone</li>
  </ul>
<% end %>

<% if @errors && !@errors.empty? %>
  <div class="mt-4">
    <% alert_box_error('Message could not be published') do %>
      <ul class="list-disc ml-6">
        <% @errors.each_value do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<%
  publish_path = explorer_messages_path(@topic_id, 'publish')
%>

<div class="card bg-base-100 mt-4">
  <div class="card-body">
    <form
      class="space-y-4 w-full mt-6"
      method="post"
      action="<%= publish_path %>"
      id="message-publish-form"
      enctype="multipart/form-data"
      data-turbo="false"
    >
      <div class="flex items-center w-full mb-6">
        <label class="w-1/4 text-base-content/70">Target Topic:</label>
        <div class="w-3/4">
          <code class="bg-base-200 px-2 py-1 rounded-sm"><%= @topic_id %></code>
        </div>
      </div>

      <div class="flex items-start w-full mb-6">
        <label class="w-1/4 text-base-content/70 mt-2">Payload:</label>
        <div class="w-3/4">
          <textarea
            name="payload"
            class="block textarea textarea-bordered w-full font-mono"
            rows="8"
            placeholder="Message payload"
            id="payload"
          ><%= @publish_form[:payload] %></textarea>
          <div class="text-sm text-base-content/70 mt-1">
            The message payload, produced as raw bytes exactly as provided
          </div>

          <div class="mt-3">
            <input
              type="file"
              name="payload_file"
              class="block file-input file-input-bordered w-full"
              id="payload_file"
            >
            <div class="text-sm text-base-content/70 mt-1">
              Optional. Upload a file to use as the payload, useful for binary data. When provided,
              the uploaded file takes precedence over the text above
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center w-full mb-6">
        <label class="w-1/4 text-base-content/70">Key:</label>
        <div class="w-3/4">
          <input
            type="text"
            name="key"
            class="block input input-bordered w-full"
            placeholder="Leave empty for no key"
            id="key"
            value="<%= @publish_form[:key] %>"
            autocomplete="off"
          >
          <div class="text-sm text-base-content/70 mt-1">
            Optional. Used for partition assignment when no explicit partition is provided
          </div>
        </div>
      </div>

      <div class="flex items-center w-full mb-6">
        <label class="w-1/4 text-base-content/70">Partition:</label>
        <div class="w-3/4">
          <select name="partition" class="select select-bordered w-full" id="partition">
            <option value="" <%= @publish_form[:partition].empty? ? 'selected' : '' %>>
              Automatic (based on key or round-robin)
            </option>
            <% @partitions_count.times do |partition_id| %>
              <option
                value="<%= partition_id %>"
                <%= @publish_form[:partition] == partition_id.to_s ? 'selected' : '' %>
              >
                <%= partition_id %>
              </option>
            <% end %>
          </select>
          <div class="text-sm text-base-content/70 mt-1">
            Optional. This topic has <%= @partitions_count %> partition(s). Leave on Automatic to
            assign based on the key or round-robin strategy
          </div>
        </div>
      </div>

      <div class="flex items-start w-full mb-8">
        <label class="w-1/4 text-base-content/70 mt-2">Headers:</label>
        <div class="w-3/4">
          <textarea
            name="headers"
            class="block textarea textarea-bordered w-full font-mono"
            rows="4"
            placeholder="key: value"
            id="headers"
          ><%= @publish_form[:headers] %></textarea>
          <div class="text-sm text-base-content/70 mt-1">
            Optional. One header per line, written as <code>key: value</code>. Lines that are not in
            that format will prevent publishing
          </div>
        </div>
      </div>

      <%
        # Return to where the user most likely came from: the specific partition view when a
        # partition was prefilled, otherwise the topic view
        cancel_path = @publish_form[:partition].empty? ?
          explorer_topics_path(@topic_id) :
          explorer_topics_path(@topic_id, @publish_form[:partition])
      %>

      <div class="fieldset text-center mt-6">
        <div class="flex gap-4 justify-end">
          <a href="<%= cancel_path %>" class="btn btn-ghost">
            Cancel
          </a>
          <button type="submit" class="btn btn-primary gap-2 btn-lockable">
            <%== icon(:arrow_up_tray) %>
            Publish Message
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
