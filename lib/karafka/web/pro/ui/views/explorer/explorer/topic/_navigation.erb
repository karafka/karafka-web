<%#
  Navigation actions of a topic. They stay visible, but disabled, when the topic has no data
  to navigate, so the actions bar keeps its shape.

  @param messages [Array] messages of the current page
%>
<% no_data_reason = 'This topic is empty and does not contain any data' if messages.empty? && params.current_page == 1 %>

<%==
  action_icon_link(
    icon(:play_circle),
    explorer_topics_path(@topic_id, 'recent'),
    title: 'Display the most recent message for this topic with auto-refresh',
    disabled_reason: no_data_reason
  )
%>

<%==
  action_icon_link(
    icon(:magnifying_glass),
    explorer_path(@topic_id, 'search'),
    title: 'Search in this topic',
    disabled_reason: no_data_reason
  )
%>
