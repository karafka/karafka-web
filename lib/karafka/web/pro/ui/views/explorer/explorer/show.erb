<% if @message %>
  <% view_title "Message with offset #{@offset} from partition #{@partition_id}" %>

  <%
    surrounding_path = explorer_topics_path(@message.topic, @message.partition, @message.offset, 'surrounding')
  %>
  <div class="col-span-12">
    <section class="actions">
      <%==
        action_icon_link(
          icon(:arrow_uturn_right),
          explorer_messages_path(@message.topic, @message.partition, @message.offset, 'forward'),
          title: 'Republish this message',
          disabled_reason: @visibility_filter.republish?(@message) ? nil : 'Republishing this message is not allowed by the Web UI policies'
        )
      %>

      <%==
        action_icon_link(
          icon(:arrows_right_left),
          surrounding_path,
          title: 'Go to this message surrounding position'
        )
      %>

      <%==
        action_icon_link(
          icon(:arrow_down_tray),
          explorer_messages_path(@message.topic, @message.partition, @message.offset, 'download'),
          title: 'Download raw payload',
          turbo: false,
          disabled_reason: @visibility_filter.download?(@message) ? nil : 'Downloading the raw payload of this message is not allowed by the Web UI policies'
        )
      %>

      <%
        export_disabled_reason = nil

        if !@visibility_filter.export?(@message)
          export_disabled_reason = 'Exporting this message is not allowed by the Web UI policies'
        elsif !@safe_payload.success? || !@safe_pretty_payload.success?
          export_disabled_reason = 'Exporting is not available because the payload of this message could not be deserialized'
        end
      %>
      <%==
        action_icon_link(
          icon(:arrow_down_on_square),
          explorer_messages_path(@message.topic, @message.partition, @message.offset, 'export'),
          title: 'Export as JSON',
          turbo: false,
          disabled_reason: export_disabled_reason
        )
      %>

      <button
        type="button"
        class="btn-action btn-toggle"
        title="Show the message metadata details"
        id="metadata-button"
        data-toggle-target="metadata-details"
      >
        <%== icon(:circle_stack) %>
      </button>

      <button
        type="button"
        class="btn-action btn-toggle"
        title="Show the message utilization details"
        id="utilization-button"
        data-toggle-target="utilization-details"
      >
        <%== icon(:cpu) %>
      </button>

      <%# Destructive actions sit last and apart so they are not clicked by accident %>
      <div class="actions-danger-zone">
        <%==
          action_icon_link(
            icon(:scissors),
            explorer_messages_path(@message.topic, @message.partition, @message.offset, 'delete'),
            title: 'Delete messages up to this offset',
            disabled_reason: @visibility_filter.delete_records?(@message.topic, @message.partition) ? nil : 'Deleting messages of this partition is not allowed by the Web UI policies'
          )
        %>
      </div>
    </section>
  </div>

  <div class="col-span-12 mb-6">
    <div id="utilization-details" class="hidden">
      <h2 class="h2">
        Utilization
      </h2>

      <%== partial 'explorer/explorer/message/resources_utilization' %>
    </div>

    <div id="metadata-details">
      <h2 class="h2">
        Metadata
      </h2>

      <%== partial 'explorer/explorer/message/metadata' %>
    </div>

    <h2 class="h2">
      Payload
    </h2>

    <%== partial 'explorer/explorer/message/payload' %>
  </div>
<% else %>
  <% view_title "Message with offset #{@offset} from partition #{@partition_id} (No Data)" %>

  <%== partial 'shared/compacted_message_info' %>
<% end %>
