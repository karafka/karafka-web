<div class="grid grid-cols-12">
  <div class="col-span-4">
    <section class="actions">
      <%==
        action_icon_link(
          icon(:plus),
          explorer_messages_path(@topic_id, 'publish'),
          title: 'Publish a new message to this topic',
          disabled_reason: @visibility_filter.publish?(@topic_id) ? nil : 'Publishing messages to this topic is not allowed by the Web UI policies'
        )
      %>

      <%== partial 'explorer/explorer/topic/navigation', locals: { messages: @messages } %>
    </section>
  </div>

  <div class="col-span-8 mb-3">
    <section class="actions">
      <%== partial 'explorer/explorer/selector' %>
    </section>
  </div>
</div>
