<% view_title 'Cluster' %>

<%== partial 'cluster/tabs' %>

<% if filtering? || !@distribution.empty? %>
  <div class="col-span-12 mb-3">
    <%== filter_box(labels: { broker_id: 'Node ID', broker_name: 'Name' }) %>
  </div>
<% end %>

<div class="col-span-12 mb-3">
  <% if @distribution.empty? && filtering? %>
    <%== partial 'shared/no_filter_results' %>
  <% else %>
    <%# A one-bar chart adds nothing, so only plot when there is more than one broker to compare %>
    <% if @distribution.size > 1 %>
      <% data = { 'Leader partitions': @distribution.map { [_1.broker_id, _1.leader_count] } }.to_json %>
      <div class="mb-5">
        <%== partial 'shared/charts/bar', locals: { data: data, id: 'broker-distribution' } %>
      </div>
    <% end %>
    <%== partial 'cluster/distribution_table' %>
  <% end %>
</div>
