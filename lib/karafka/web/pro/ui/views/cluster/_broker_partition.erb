<tr>
  <td>
    <a href="<%= explorer_topics_path(broker_partition.topic_name) %>">
      <%= broker_partition.topic_name %>
    </a>
  </td>
  <td>
    <a href="<%= explorer_topics_path(broker_partition.topic_name, broker_partition.partition_id) %>">
      <%= broker_partition.partition_id %>
    </a>
  </td>
  <td>
    <span class="badge <%= (broker_partition.role == :leader) ? 'badge-primary' : 'badge-info' %>">
      <%= broker_partition.role %>
    </span>
  </td>
  <td>
    <% if broker_partition.in_sync %>
      <span class="badge badge-success">in-sync</span>
    <% else %>
      <span class="badge badge-warning">out-of-sync</span>
    <% end %>
  </td>
</tr>
