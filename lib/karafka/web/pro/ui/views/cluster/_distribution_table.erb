<div class="mb-3 flex justify-end">
  <small class="text-muted">
    Distribution of partition leadership and replicas across the cluster brokers
  </small>
</div>

<div class="data-table-wrapper">
  <table class="data-table">
    <thead>
      <tr>
        <th><%== sort_link('Node ID', :broker_id) %></th>
        <th><%== sort_link('Name', :broker_name) %></th>
        <th><%== sort_link('Leader partitions', :leader_count) %></th>
        <th><%== sort_link('Leader share', :leader_share) %></th>
        <th><%== sort_link('Replica partitions', :replica_count) %></th>
        <th><%== sort_link('Replica share', :replica_share) %></th>
      </tr>
    </thead>
    <tbody>
      <%==
        each_partial(
          @distribution,
          'cluster/distribution'
        )
      %>
    </tbody>
  </table>
</div>
