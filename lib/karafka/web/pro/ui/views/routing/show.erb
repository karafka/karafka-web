<%
  title = [@topic.group.name, @topic.subscription_group, @topic.name].join(': ')
  view_title title
%>

<% if filtering? || !@details.empty? %>
  <div class="col-span-12 mb-3">
    <%== filter_box(labels: { name: 'Attribute' }) %>
  </div>
<% end %>

<% if filtering? && @details.empty? %>
  <div class="col-span-12">
    <%== partial 'shared/no_filter_results' %>
  </div>
<% else %>
  <div class="data-table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th><%== sort_link('Attribute', :name) %></th>
          <th><%== sort_link(:value) %></th>
        </tr>
      </thead>
      <tbody>
        <% @details.each do |detail| %>
          <%==
            partial(
              'routing/detail',
              locals: {
                k: detail[:name],
                v: detail[:value]
              }
            )
          %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
