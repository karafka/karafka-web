<form method="get" action="<%= request.path %>" class="filter-form flex gap-2 mb-6">
  <% hidden_params.each do |key, value| %>
    <input type="hidden" name="<%= key %>" value="<%= value %>">
  <% end %>

  <% if fielded %>
    <div class="join grow">
      <select name="filter[field]" class="select join-item">
        <% fields.each do |field| %>
          <option value="<%= field %>"<%= " selected" if field.to_s == selected %>>
            <%= filter_field_label(field, labels) %>
          </option>
        <% end %>
      </select>

      <input
        type="text"
        name="<%= value_name %>"
        value="<%= keyword %>"
        placeholder="Filter..."
        class="input w-full join-item"
        autocomplete="off"
      >
    </div>
  <% else %>
    <input
      type="text"
      name="<%= value_name %>"
      value="<%= keyword %>"
      placeholder="Filter..."
      class="input w-full grow"
      autocomplete="off"
    >
  <% end %>

  <button type="submit" class="btn btn-primary font-normal">Search</button>

  <% if active %>
    <a class="btn btn-outline font-normal" href="<%= clear_path %>">Reset</a>
  <% else %>
    <a class="btn btn-outline font-normal btn-disabled" aria-disabled="true">Reset</a>
  <% end %>
</form>
