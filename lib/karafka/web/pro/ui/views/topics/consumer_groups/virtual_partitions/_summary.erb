<% summary = @result[:summary] %>
<% settings = @result[:settings] %>

<p class="text-end mb-5">
  <span class="badge <%= vp_verdict_badge(summary[:verdict]) %>">
    Verdict: <%= vp_verdict_label(summary[:verdict]) %>
  </span>
  <%== badge_primary("Score: #{vp_metric(summary[:score], ' / 100')}") %>
  <%== badge_primary("Speedup: #{vp_metric(summary[:avg_speedup], 'x')}") %>
  <%== badge_primary("Active VPs: #{summary[:avg_active_vps]} of #{settings[:concurrency]}") %>
  <%== badge_primary("Utilization: #{vp_metric(summary[:avg_utilization], '%')}") %>
  <%== badge_primary("Imbalance: #{vp_metric(summary[:avg_load_imbalance], '%')}") %>
</p>

<p class="text-end mb-5">
  <%== badge_secondary("Messages: #{number_with_delimiter(summary[:messages], ' ')}") %>
  <%== badge_secondary("Batches: #{summary[:batches]}") %>
  <%== badge_secondary("Collapsed batches: #{summary[:collapsed_batches]}") %>
  <%== badge_secondary("Poor batches: #{summary[:poor_batches]}") %>
  <%== badge_secondary("Single VP batches: #{summary[:single_vp_batches]}") %>

  <% partitions_range = [@active_partitions.first, @active_partitions.last].uniq.join(' to ') %>
  <%== badge_secondary("Partitions: #{partitions_range}") %>
</p>

<p class="text-end text-sm text-base-content/70 mb-5">
  Concurrency: <%= settings[:concurrency] %>,
  distribution: <%= settings[:distribution] %>,
  batch size: <%= settings[:batch_size] %>,
  sample size: <%= number_with_delimiter(settings[:sample_size]) %>,
  grouped by message key.
</p>
