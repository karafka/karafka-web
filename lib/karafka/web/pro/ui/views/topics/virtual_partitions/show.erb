<% view_title "#{@topic.topic_name} Virtual Partitions" %>

<%== partial 'topics/topics/tabs' %>

<% if @limited %>
  <%== partial 'topics/virtual_partitions/limited' %>
<% end %>

<% if @errors && !@errors.empty? %>
  <%== partial 'shared/form_errors_alert_box' %>
<% end %>

<%== partial 'topics/virtual_partitions/form' %>

<% if @timeout %>
  <%== partial 'topics/virtual_partitions/timeout' %>
<% elsif @result && @result[:summary][:batches].zero? %>
  <%== partial 'topics/virtual_partitions/empty_partitions' %>
<% elsif @result %>
  <div class="col-span-12 mb-3">
    <%== partial 'topics/virtual_partitions/summary' %>

    <div class="data-table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th><%== sort_link(:partition_id) %></th>
            <th><%== sort_link(:messages) %></th>
            <th><%== sort_link(:batches) %></th>
            <th><%== sort_link(:score) %></th>
            <th>Verdict</th>
            <th><%== sort_link('Speedup', :avg_speedup) %></th>
            <th><%== sort_link('Active VPs', :avg_active_vps) %></th>
            <th><%== sort_link('Utilization', :avg_utilization) %></th>
            <th><%== sort_link('Imbalance', :avg_load_imbalance) %></th>
            <th><%== sort_link('Collapsed', :collapsed_batches) %></th>
            <th><%== sort_link('Poor', :poor_batches) %></th>
            <th><%== sort_link('Single VP', :single_vp_batches) %></th>
          </tr>
        </thead>
        <tbody>
          <%==
            each_partial(
              @partitions,
              'topics/virtual_partitions/partition'
            )
          %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%== partial 'topics/virtual_partitions/notes' %>
