<%==
  action_form_button(
    icon(:play),
    root_path('recurring_tasks', task.id, 'trigger'),
    classes: 'btn-primary btn-sm',
    title: 'Trigger',
    disabled_reason: task.enabled? ? nil : 'Enable this task to trigger it'
  )
%>

<%==
  action_form_button(
    icon(:check),
    root_path('recurring_tasks', task.id, 'enable'),
    classes: 'btn-success btn-sm',
    title: 'Enable',
    disabled_reason: task.enabled? ? 'This task is already enabled' : nil
  )
%>

<%==
  action_form_button(
    icon(:pause),
    root_path('recurring_tasks', task.id, 'disable'),
    classes: 'btn-warning btn-sm',
    title: 'Disable',
    disabled_reason: task.enabled? ? nil : 'This task is already disabled'
  )
%>
